# Copy to .env (gitignored, never committed).
#
# Free Groq API key: console.groq.com -> API Keys -> Create API Key.
# No credit card required. See llm_client.py for why Groq is primary here
# instead of local Ollama (8GB RAM dev machine, see LOGS.md).
#
# Comma-separated list supported (round-robins across them, see
# llm_client.py) -- useful since self-consistency sampling makes 3 calls per
# message and a free-tier key's rate limit is easy to hit otherwise. A
# single key also works fine, just set GROQ_API_KEY instead.
GROQ_API_KEYS=
# GROQ_API_KEY=

# Optional overrides -- these all have sane defaults in code.
# GROQ_MODEL=openai/gpt-oss-20b
# DATABASE_URL=postgresql://pranaysb@localhost:5432/intake
# CONFIDENCE_THRESHOLD=0.7
