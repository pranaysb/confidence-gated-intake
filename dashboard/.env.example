# Copy to .env.local. No API keys -- just where to find Postgres.
#
# This project runs against a native (non-Docker) Postgres install by
# default -- see LOGS.md for why. Replace `pranaysb` with your own OS
# username (Homebrew Postgres uses trust auth for the current user, no
# password) or with your actual Postgres credentials if different.
#
# If you're using docker-compose.yml instead (Docker installed and
# resourced fine on your machine), use:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5433/intake
DATABASE_URL=postgresql://pranaysb@localhost:5432/intake
